<div>
<div class='table-container {{table.units}}-units' v-if="{{table.units}}_visible">
{% if meta.datatable %}
<span id="dt-data-{{ meta.dt_id }}" data-config="{{ meta.dt_config }}" data-id="{{ meta.dt_id }}">
{% endif %}
 <div class='fixed-container {{meta.scrolling}}' style={{meta.special}}>
    <table class="table is-bordered is-striped" width="100%" id="datatable-{{meta.dt_id}}">
        <thead class="fixed-thead">
            {% for heading in table.headings %} 
                <tr style={{heading.style}}>
                    {%for header in heading.data %}
                        <th class=" fixed-header {{header.type}}" scope="col" colspan={{header.colspan}} style={{header.style}}> {{header.data}}</th>
                    {% endfor %}
                </tr>
            {% endfor %}
        </thead>
        <tbody>
            {% for row in table.rows %} 
                <tr style={{row.style}}>
                    {%for column in row.data %}
                        {% if column.type == 'image'%}
                            <td class="{{column.type}}" colspan={{column.colspan}} style={{column.style}}> <img src="{{column.data}}" alt="image data" max-width="{{column.width}}px" max-height="{{column.height}}px" height="auto" width="auto"></td>
                        {% else %}
                            {% if loop.index in meta.wrap_cols %}
                                <td class="{{column.type}} align-middle" colspan={{column.colspan}} style={{column.style}}> 
                                    <div style="white-space: normal; overflow-wrap: break-word;">{{column.data}}</div>
                                </td>
                            {% else %}
                                <td class="{{column.type}}" colspan={{column.colspan}} style={{column.style}}> {{column.data}}</td>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
 </div>
</div>
</div>